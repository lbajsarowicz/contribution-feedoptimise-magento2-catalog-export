{
  "name": "feedoptimise/magento2-catalog-export",
  "description": "Exports catalog data, from Magento2 stores, which is used to generate product feeds.",
  "type": "magento2-module",
  "version": "1.2.44",
  "require": {
	"php": ">=7.0"
  },
  "authors": [
	  {
		  "name": "Feedoptimise",
		  "homepage": "https://www.feedoptimise.com/",
		  "role": "Developer"
	  }
  ],
  "autoload": {
	"files": [
	  "src/registration.php"
	],
	"psr-4": {
	  "Feedoptimise\\CatalogExport\\": "src/"
	}
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
